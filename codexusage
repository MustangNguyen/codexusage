#!/usr/bin/env bash
set -e
url=http://127.0.0.1:8766/
healthy() {
    curl --noproxy '*' --max-time 2 --fail --silent "${url}api/usage" | python3 -c 'import sys,json; d=json.load(sys.stdin); sys.exit(0 if d.get("ready") and not d.get("error") else 1)' 2>/dev/null
}
systemctl --user start codex-usage-dashboard.service
if ! healthy; then
    systemctl --user restart codex-usage-dashboard.service
fi
for attempt in {1..60}; do
    if healthy; then
        xdg-open "$url" >/dev/null 2>&1 &
        exit 0
    fi
    sleep 0.5
done
printf '%s\n' 'Dashboard chưa phản hồi. Xem: journalctl --user -u codex-usage-dashboard -n 20' >&2
exit 1
